NUXT_MONGODB_URI=
NUXT_SESSION_SECRET=
NUXT_REDIS_URL=

# Day-of reminder emails (server/utils/email.ts) — leave blank and
# sendEmail() logs instead of sending.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=
NUXT_APP_URL=http://localhost:3000

# Secures GET /api/cron/send-reminders — set the same value as CRON_SECRET
# (no NUXT_ prefix) in your Vercel project's environment variables.
CRON_SECRET=
